# Copy to .env and fill in. .env is git-ignored: never commit real keys.

# --- API keys ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=                   # only for ACCEX_TTS=elevenlabs

# --- brain (P2) ---
ACCEX_LLM_PROVIDER=anthropic          # anthropic | openai (openai needs an OpenAI model name below)
ACCEX_LLM_MODEL=claude-haiku-5-5      # fastest; claude-opus-5-5 if a task needs more accuracy
ACCEX_LLM_EFFORT=low                  # low keeps latency down
ACCEX_LLM_TIMEOUT=20                  # seconds per request
ACCEX_LLM_FALLBACKS=1                 # 1 = server-side fallback model if Claude declines
ACCEX_HISTORY_TURNS=12                # question/answer pairs remembered
ACCEX_SCREEN_MAX_SIDE=1280            # screenshot longest side sent to the model
ACCEX_SCREEN_QUALITY=80               # JPEG quality
ACCEX_MAX_STEPS=10                    # max actions per spoken request (multi-step tasks)
ACCEX_SETTLE_SCALE=1                  # multiplies the wait after each action before looking again

# --- voice (P1) ---
ACCEX_HOTKEY=ctrl_r                   # pynput key name; avoid insert/caps_lock (NVDA)
ACCEX_MIC_DEVICE=                     # empty = system default input
ACCEX_STT_MODEL=gpt-4o-mini-transcribe
ACCEX_TTS=sapi                        # sapi | openai | elevenlabs (both fall back to SAPI on errors)
ACCEX_ELEVEN_VOICE=                   # voice id; list them with: python -m voice.elevenlabs --voices
ACCEX_ELEVEN_MODEL=eleven_flash_v2_5  # lowest-latency ElevenLabs model
ACCEX_ELEVEN_SPEED=1.0                # 0.7..1.2
ACCEX_TTS_RATE=0                      # SAPI rate, -10..10
ACCEX_TTS_VOICE=coral                 # openai TTS voice (ACCEX_TTS=openai; falls back to SAPI on errors)
ACCEX_TTS_MODEL=gpt-4o-mini-tts

# --- runtime ---
ACCEX_MOCK=                           # e.g. all   or   brain,actions
ACCEX_DEMO=0                          # 1 = print every event to the console
ACCEX_DRY_RUN=0                       # 1 = log actions instead of running them

# --- senior mode (P2) --- default profile = behaviour unchanged
ACCEX_PROFILE=default                 # default | senior
ACCEX_FAMILY_PROFILE=family.json      # copy family.example.json; git-ignored (personal data)
ACCEX_FAMILY_LOG=logs/family.jsonl    # append-only family view: asked/clarified/blocked/done/failed
ACCEX_SENIOR_ELEVEN_SPEED=1.2         # senior only: overrides ACCEX_ELEVEN_SPEED
ACCEX_SENIOR_TTS_RATE=1               # senior only: overrides ACCEX_TTS_RATE (Windows voice)
ACCEX_SENIOR_STT_MIN_RMS=30           # senior only: accept quieter voices (ACCEX_STT_MIN_RMS)

# --- interface ---
ACCEX_UI=0                            # 1 = show the floating glass pill (same as --ui)
ACCEX_UI_CAPTURABLE=0                 # 1 = let screen recorders capture the pill (the model will see it too)
