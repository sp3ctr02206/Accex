# Copy to .env and fill in. .env is git-ignored: never commit real keys.

# --- API keys ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- brain (P2) ---
ACCEX_LLM_PROVIDER=anthropic          # anthropic | openai (openai needs an OpenAI model name below)
ACCEX_LLM_MODEL=claude-haiku-5-5      # fastest; claude-opus-5-5 if a task needs more accuracy
ACCEX_LLM_EFFORT=low                  # low keeps latency down
ACCEX_LLM_TIMEOUT=20                  # seconds per request
ACCEX_LLM_FALLBACKS=1                 # 1 = server-side fallback model if Claude declines
ACCEX_HISTORY_TURNS=6                 # question/answer pairs remembered
ACCEX_SCREEN_MAX_SIDE=1280            # screenshot longest side sent to the model
ACCEX_SCREEN_QUALITY=80               # JPEG quality

# --- voice (P1) ---
ACCEX_HOTKEY=ctrl_r                   # pynput key name; avoid insert/caps_lock (NVDA)
ACCEX_MIC_DEVICE=                     # empty = system default input
ACCEX_STT_MODEL=gpt-4o-mini-transcribe
ACCEX_TTS=sapi                        # sapi | openai
ACCEX_TTS_RATE=0                      # SAPI rate, -10..10
ACCEX_TTS_VOICE=coral                 # openai TTS voice (ACCEX_TTS=openai; falls back to SAPI on errors)
ACCEX_TTS_MODEL=gpt-4o-mini-tts

# --- runtime ---
ACCEX_MOCK=                           # e.g. all   or   brain,actions
ACCEX_DEMO=0                          # 1 = print every event to the console
ACCEX_DRY_RUN=0                       # 1 = log actions instead of running them
